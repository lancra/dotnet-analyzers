    <PackageVersion Include="TheExceptionator.Analyzers" Version="1.3.32" />
    <PackageVersion Include="TUnit" Version="1.64.13" />
    <PackageVersion Include="xunit.analyzers" Version="1.27.0" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
